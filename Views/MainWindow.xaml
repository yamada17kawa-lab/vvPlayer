<Window x:Class="MyMediaPlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:vm="clr-namespace:MyMediaPlayer.ViewModels"
        xmlns:models="clr-namespace:MyMediaPlayer.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle, FallbackValue='vv播放器'}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="680" Width="1120"
        MinHeight="480" MinWidth="760"
        Background="#121318"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewKeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 小号紧凑按钮样式（用于播放目录工具栏） -->
        <Style x:Key="MiniButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252836" />
            <Setter Property="Foreground" Value="#E2E5F0" />
            <Setter Property="BorderBrush" Value="#383E54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#363C54" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#5865F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C1F2B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平化现代按钮样式 -->
        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252836" />
            <Setter Property="Foreground" Value="#F0F2F8" />
            <Setter Property="BorderBrush" Value="#363B4E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34394C" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#5865F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E212B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 顶部状态栏 -->
            <RowDefinition Height="Auto" />
            <!-- 视频与字幕悬浮层 -->
            <RowDefinition Height="*" />
            <!-- 底部播放控制条 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题与 AI 状态栏 -->
        <Border Grid.Row="0" x:Name="TopBar" Background="#1A1C24" Padding="16,10" BorderBrush="#262936" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎬 " FontSize="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VideoTitle}"
                               Foreground="#E2E5F0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1" Background="#242838" CornerRadius="12" Padding="12,4" BorderBrush="#383E56" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#43B581" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AiStatusText}" Foreground="#B9C0D4" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. 播放目录侧边栏 + 视频渲染区 + 内部 Foreground 悬浮字幕层 -->
        <Grid Grid.Row="1" Background="#090A0D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：播放目录侧边栏（分类管理，只保存原视频地址，可折叠） -->
            <Border Grid.Column="0"
                    x:Name="PlaylistSidebar"
                    Width="280"
                    Background="#161822"
                    BorderBrush="#25293A"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsPlaylistVisible, Converter={StaticResource BoolToVis}}"
                    AllowDrop="True"
                    Drop="PlaylistTree_Drop"
                    DragOver="PlaylistTree_DragOver">
                <Grid Margin="12,10,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部标题与收起按钮 -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋 播放目录"
                                       Foreground="#E0E4F0"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Text=" (分类管理)"
                                       Foreground="#7A849E"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                        <Button Content="✕"
                                ToolTip="收起目录 (可在底部随时展开)"
                                Command="{Binding TogglePlaylistCommand}"
                                HorizontalAlignment="Right"
                                Style="{StaticResource MiniButtonStyle}"
                                Padding="6,1" />
                    </Grid>

                    <!-- 按钮工具栏：新建目录、添加视频、当前、重命名、删除 -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="➕ 目录"
                                Command="{Binding Playlist.NewFolderCommand}"
                                ToolTip="新建分类目录"
                                Style="{StaticResource MiniButtonStyle}"
                                Margin="0,0,4,4" />
                        <Button Content="➕ 视频"
                                Command="{Binding Playlist.AddVideosCommand}"
                                ToolTip="添加本地视频到选中的分类目录（仅记录视频地址）"
                                Style="{StaticResource MiniButtonStyle}"
                                Margin="0,0,4,4" />
                        <Button Content="+当前"
                                Command="{Binding Playlist.AddCurrentVideoCommand}"
                                ToolTip="将当前播放的视频添加到选中的分类目录"
                                Style="{StaticResource MiniButtonStyle}"
                                Margin="0,0,4,4" />
                        <Button Content="✏"
                                Command="{Binding Playlist.RenameCommand}"
                                ToolTip="重命名选中的目录或视频条目"
                                Style="{StaticResource MiniButtonStyle}"
                                Margin="0,0,4,4" />
                        <Button Content="🗑"
                                Command="{Binding Playlist.DeleteCommand}"
                                ToolTip="移出播放目录（仅删除记录，不会删除原视频文件）"
                                Style="{StaticResource MiniButtonStyle}"
                                Margin="0,0,0,4" />
                    </WrapPanel>

                    <!-- 目录树视图 -->
                    <TreeView Grid.Row="2"
                              x:Name="PlaylistTree"
                              ItemsSource="{Binding Playlist.Roots}"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#D0D6E8"
                              SelectedItemChanged="PlaylistTree_SelectedItemChanged"
                              MouseDoubleClick="PlaylistTree_MouseDoubleClick"
                              PreviewMouseRightButtonDown="PlaylistTree_PreviewMouseRightButtonDown"
                              PreviewMouseMove="PlaylistTree_PreviewMouseMove"
                              AllowDrop="True"
                              Drop="PlaylistTree_Drop"
                              DragOver="PlaylistTree_DragOver">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="#D0D6E8" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Padding" Value="2,3" />
                                <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Background="#202330" Foreground="#F0F2F8" BorderBrush="#353A4C">
                                            <MenuItem Header="▶ 播放此视频"
                                                      Command="{Binding DataContext.Playlist.PlaySelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
                                            <MenuItem Header="➕ 新建子目录"
                                                      Command="{Binding DataContext.Playlist.NewFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <MenuItem Header="➕ 添加视频到此目录"
                                                      Command="{Binding DataContext.Playlist.AddVideosCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Separator Background="#353A4C" />
                                            <MenuItem Header="📂 在文件夹中显示原文件"
                                                      Command="{Binding DataContext.Playlist.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
                                            <MenuItem Header="✏ 重命名"
                                                      Command="{Binding DataContext.Playlist.RenameCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <MenuItem Header="🗑 移出播放目录 (不删原文件)"
                                                      Command="{Binding DataContext.Playlist.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:PlaylistNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <!-- 正在播放徽标 -->
                                    <TextBlock Text="▶ "
                                               Foreground="#43B581"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                                    <!-- 图标（文件夹📁 / 视频🎞 / 丢失⚠） -->
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="13"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center" />
                                    <!-- 名称及数量 -->
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="175" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- 空目录引导提示 -->
                    <Border Grid.Row="2"
                            Background="#181A24"
                            CornerRadius="6"
                            Padding="12,24"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            BorderBrush="#25293A"
                            BorderThickness="1"
                            IsHitTestVisible="False"
                            Visibility="{Binding Playlist.IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="暂无分类目录"
                                       Foreground="#E0E4F0"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="点击上方「➕ 目录」创建&#x0a;或直接将视频/文件夹拖入此处"
                                       Foreground="#7A849E"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 底部提示 -->
                    <TextBlock Grid.Row="3"
                               Text="💡 仅存储原视频路径，不占磁盘空间"
                               Foreground="#6B738A"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </Grid>
            </Border>

            <!-- 右侧：视频渲染区 (Grid.Column="1") -->
            <vlc:VideoView Grid.Column="1"
                           x:Name="VideoView"
                           MediaPlayer="{Binding MediaPlayer}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch">
                <!-- VideoView 内部的内容会被渲染在独立透明覆盖层上，永远不会被视频画面遮挡 -->
                <Grid Background="Transparent"
                      MouseMove="VideoSurface_MouseMove"
                      MouseLeave="VideoSurface_MouseLeave"
                      MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown">
                    <!-- 未播放视频时的待机应用封面层 -->
                    <Grid Visibility="{Binding IsCoverVisible, Converter={StaticResource BoolToVis}}"
                          Background="#FFFFFF"
                          Cursor="Hand">
                        <Image Source="pack://application:,,,/Assets/cover.jpg"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,28"
                                Padding="18,8"
                                CornerRadius="20"
                                Background="#CC1A1C24"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1">
                            <TextBlock Text="🎬 点击画面选择视频，或直接将视频文件拖入窗口"
                                       Foreground="#F0F2F8"
                                       FontSize="13" />
                        </Border>
                    </Grid>

                    <!-- 底部字幕悬浮框（半透明黑底 + 黄色译文字体 + 浅白原文字体） -->
                    <Border x:Name="SubtitleBorder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="40,0,40,36"
                            Padding="22,12"
                            CornerRadius="8"
                            Background="#B8000000"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            MaxWidth="920"
                            Visibility="{Binding IsSubtitleVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- 识别出的外语原文 -->
                            <TextBlock x:Name="OriginalSubtitleTextBlock"
                                       Text="{Binding CurrentOriginalSubtitle}"
                                       Visibility="{Binding ShowBilingual, Converter={StaticResource BoolToVis}}"
                                       Foreground="#D8DCE6"
                                       FontSize="15"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.9" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- 机器翻译后的目标语言（醒目黄色字体） -->
                            <TextBlock x:Name="TranslatedSubtitleTextBlock"
                                       Text="{Binding CurrentTranslatedSubtitle}"
                                       Foreground="#FFD700"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.95" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 小窗口模式悬浮交互层（置顶时鼠标悬浮显示，包含顶部标题拖拽条与底部紧凑控制条，支持前后10秒快捷键） -->
                    <Grid x:Name="MiniOverlayGrid"
                          Visibility="Collapsed"
                          Background="#10000000">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 小窗口顶部标题栏（支持拖拽移动窗口、恢复大窗口、关闭） -->
                        <Border Grid.Row="0"
                                x:Name="MiniTopBar"
                                Background="#D9161822"
                                Padding="10,6"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="0,0,0,1"
                                MouseLeftButtonDown="MiniTopBar_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📺 " FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding VideoTitle}"
                                               Foreground="#E0E4F0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="240"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="🗗 恢复"
                                            Click="MiniRestoreButton_Click"
                                            ToolTip="恢复为标准播放窗口 (快捷键 Esc 或双击)"
                                            Style="{StaticResource MiniButtonStyle}"
                                            Padding="6,2"
                                            FontSize="10"
                                            Margin="0,0,6,0" />
                                    <Button Content="✕"
                                            Click="MiniCloseButton_Click"
                                            ToolTip="关闭播放器"
                                            Style="{StaticResource MiniButtonStyle}"
                                            Padding="6,2"
                                            FontSize="10" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 中间透明区域：双击可恢复窗口，按住可直接拖拽移动 -->

                        <!-- 小窗口底部紧凑播放控制条 -->
                        <Border Grid.Row="2"
                                x:Name="MiniBottomBar"
                                Background="#E0161822"
                                Padding="10,6"
                                BorderBrush="#25FFFFFF"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 小窗口进度条与紧凑时间显示 -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding FormattedCurrentTime}"
                                               Foreground="#A6B0CF"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />

                                    <Slider Grid.Column="1"
                                            x:Name="MiniTimelineSlider"
                                            Minimum="0"
                                            Maximum="{Binding TotalDurationSeconds}"
                                            Value="{Binding CurrentTimeSeconds, Mode=TwoWay}"
                                            IsMoveToPointEnabled="False"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            ValueChanged="TimelineSlider_ValueChanged"
                                            Thumb.DragStarted="TimelineSlider_DragStarted"
                                            Thumb.DragCompleted="TimelineSlider_DragCompleted"
                                            PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="TimelineSlider_PreviewMouseMove"
                                            PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
                                            LostMouseCapture="TimelineSlider_LostMouseCapture" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FormattedTotalDuration}"
                                               Foreground="#A6B0CF"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0" />
                                </Grid>

                                <!-- 小窗口核心控制按钮：快退10秒、播放/暂停、快进10秒 -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="⏪ 10s"
                                            Command="{Binding SkipBackwardCommand}"
                                            ToolTip="后退 10 秒 (Ctrl+← / J)"
                                            Style="{StaticResource MiniButtonStyle}"
                                            Padding="8,3"
                                            FontSize="11"
                                            Margin="0,0,8,0" />

                                    <Button Content="{Binding PlayPauseButtonText}"
                                            Command="{Binding TogglePlayPauseCommand}"
                                            ToolTip="播放 / 暂停 (空格)"
                                            Style="{StaticResource MiniButtonStyle}"
                                            Padding="14,3"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Margin="0,0,8,0" />

                                    <Button Content="10s ⏩"
                                            Command="{Binding SkipForwardCommand}"
                                            ToolTip="前进 10 秒 (Ctrl+→ / L)"
                                            Style="{StaticResource MiniButtonStyle}"
                                            Padding="8,3"
                                            FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </vlc:VideoView>
        </Grid>

        <!-- 3. 底部控制面板 -->
        <Border Grid.Row="2" x:Name="BottomControlBar" Background="#1A1C24" Padding="18,12" BorderBrush="#262936" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 进度条与时间显示 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="68" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding FormattedCurrentTime}"
                               Foreground="#A6B0CF"
                               FontSize="12"
                               VerticalAlignment="Center" />

                    <Slider Grid.Column="1"
                            x:Name="TimelineSlider"
                            Minimum="0"
                            Maximum="{Binding TotalDurationSeconds}"
                            Value="{Binding CurrentTimeSeconds, Mode=TwoWay}"
                            IsMoveToPointEnabled="False"
                            VerticalAlignment="Center"
                            Margin="8,0"
                            Cursor="Hand"
                            ValueChanged="TimelineSlider_ValueChanged"
                            Thumb.DragStarted="TimelineSlider_DragStarted"
                            Thumb.DragCompleted="TimelineSlider_DragCompleted"
                            PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="TimelineSlider_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
                            LostMouseCapture="TimelineSlider_LostMouseCapture" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding FormattedTotalDuration}"
                               Foreground="#A6B0CF"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 第二行：播放控制（左）+ 音量/全屏（右） -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：播放目录、打开文件 | 快退 10s、播放/暂停、快进 10s、停止 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding PlaylistToggleButtonText}"
                                Command="{Binding TogglePlaylistCommand}"
                                ToolTip="展开 / 收起左侧播放分类目录"
                                Style="{StaticResource PlayerButtonStyle}"
                                Margin="0,0,10,0" />

                        <Button Content="📂 打开视频"
                                Command="{Binding OpenFileCommand}"
                                Style="{StaticResource PlayerButtonStyle}"
                                Margin="0,0,16,0" />

                        <Button Content="⏪ 10s"
                                Command="{Binding SkipBackwardCommand}"
                                ToolTip="后退 10 秒 (Ctrl+← / J)"
                                Style="{StaticResource PlayerButtonStyle}"
                                Margin="0,0,6,0" />

                        <Button Content="{Binding PlayPauseButtonText}"
                                Command="{Binding TogglePlayPauseCommand}"
                                ToolTip="播放 / 暂停 (空格)"
                                Style="{StaticResource PlayerButtonStyle}"
                                Width="92"
                                Margin="0,0,6,0" />

                        <Button Content="10s ⏩"
                                Command="{Binding SkipForwardCommand}"
                                ToolTip="前进 10 秒 (Ctrl+→ / L)"
                                Style="{StaticResource PlayerButtonStyle}"
                                Margin="0,0,6,0" />

                        <Button Content="⏹ 停止"
                                Command="{Binding StopCommand}"
                                Style="{StaticResource PlayerButtonStyle}" />
                    </StackPanel>

                    <!-- 右侧：静音、音量、全屏 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding MuteButtonText}"
                                Command="{Binding ToggleMuteCommand}"
                                ToolTip="静音 / 取消静音"
                                Style="{StaticResource PlayerButtonStyle}"
                                Padding="8,4"
                                Margin="0,0,8,0" />

                        <Slider Minimum="0"
                                Maximum="100"
                                Value="{Binding Volume, Mode=TwoWay}"
                                Width="95"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Focusable="False"
                                Margin="0,0,16,0" />

                        <Button x:Name="MiniModeButton"
                                Content="📺 小窗口"
                                Click="MiniModeButton_Click"
                                ToolTip="切换为小窗口置顶模式 (画中画，支持前后10秒快捷键)"
                                Style="{StaticResource PlayerButtonStyle}"
                                Margin="0,0,8,0" />

                        <Button x:Name="FullScreenButton"
                                Content="⛶ 全屏"
                                Click="FullScreenButton_Click"
                                ToolTip="全屏 (F11 / 双击画面，Esc 退出)"
                                Style="{StaticResource PlayerButtonStyle}" />
                    </StackPanel>
                </Grid>

                <!-- 第三行：AI 字幕设置（语言选择、AI 开关、双语、模型目录、导出字幕），窄窗口下自动换行 -->
                <Border Grid.Row="2"
                        Margin="0,10,0,0"
                        Padding="0,10,0,0"
                        BorderBrush="#262936"
                        BorderThickness="0,1,0,0">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding AiToggleButtonText}"
                                Command="{Binding ToggleAiSubtitleCommand}"
                                Style="{StaticResource PlayerButtonStyle}"
                                Margin="0,2,14,2" />

                        <TextBlock Text="源语言:"
                                   Foreground="#9BA3B8"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding SourceLanguages}"
                                  SelectedItem="{Binding SelectedSourceLanguage, Mode=TwoWay}"
                                  Width="118"
                                  VerticalAlignment="Center"
                                  Margin="0,2,12,2" />

                        <TextBlock Text="目标:"
                                   Foreground="#9BA3B8"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding TargetLanguages}"
                                  SelectedItem="{Binding SelectedTargetLanguage, Mode=TwoWay}"
                                  Width="106"
                                  VerticalAlignment="Center"
                                  Margin="0,2,14,2" />

                        <CheckBox Content="双语原文"
                                  IsChecked="{Binding ShowBilingual}"
                                  IsEnabled="{Binding IsAiSubtitleEnabled}"
                                  Foreground="#D0D6E8"
                                  VerticalAlignment="Center"
                                  Cursor="Hand"
                                  Margin="0,2,18,2" />

                        <Button Content="📁 模型目录"
                                Command="{Binding SelectModelDirectoryCommand}"
                                ToolTip="{Binding ModelRootDirectory}"
                                Style="{StaticResource PlayerButtonStyle}"
                                Margin="0,2,8,2" />

                        <Button Content="💾 导出字幕"
                                Command="{Binding ExportSrtCommand}"
                                Style="{StaticResource PlayerButtonStyle}"
                                Margin="0,2,0,2" />
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
